    <worksheet name='Ownership'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Bold' fontsize='14'>For-profit hospitals most often exceed expected readmissions; physician-owned least often</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>Share of results above 1.0 by ownership. Black vertical reference line is at 50%. n = number of hospitals.</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>Share of hospital results with an excess readmission ratio above 1.0, by ownership. Minimum discharges = 0 includes every hospital. Any higher value keeps only hospitals with published discharges at or above it, which also removes results where CMS hid the counts (fewer than 11 readmissions). Federal (13) and Tribal (5) hospitals are grouped as Other.
Groups with fewer than 10 hospitals reporting a ratio are hidden, the same rule as the map.
</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location id='Ownership' path='/workbooks/HospitalReadmissions_17924318810080' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='hospital_condition' name='federated.0eh16tl0ng6c7r1el5xh60x6y7hx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Minimum discharges' datatype='integer' name='[Parameter 0948661309857796]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range granularity='25' max='500' min='0' />
            </column>
            <column caption='Reference line 50%' datatype='real' name='[Parameter 0948661314314246]' param-domain-type='any' role='measure' type='quantitative' value='0.5'>
              <calculation class='tableau' formula='0.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0eh16tl0ng6c7r1el5xh60x6y7hx'>
            <column caption='Hospitals with ratio' datatype='integer' name='[Calculation_0948661160878080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([excess_readmission_ratio]) THEN [facility_id] END)' />
            </column>
            <column caption='Ownership group' datatype='string' name='[Calculation_0948661308080131]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [hospital_ownership]&#13;&#10;WHEN &quot;Government - Federal&quot; THEN &quot;Other (Federal, Tribal)&quot;&#13;&#10;WHEN &quot;Tribal&quot; THEN &quot;Other (Federal, Tribal)&quot;&#13;&#10;ELSE [hospital_ownership]&#13;&#10;END' />
            </column>
            <column caption='Meets minimum discharges' datatype='boolean' name='[Calculation_0948661310402565]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 0948661309857796] = 0 OR [number_of_discharges] &gt;= [Parameters].[Parameter 0948661309857796]' />
            </column>
            <column caption='Above 1' datatype='integer' default-format='p0.0%' name='[above_1]' role='measure' type='quantitative' />
            <column-instance column='[above_1]' derivation='Avg' name='[avg:above_1:qk]' pivot='key' type='quantitative' />
            <column caption='Condition Name' datatype='string' name='[condition_name]' role='dimension' type='nominal' />
            <column caption='Excess Readmission Ratio' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[excess_readmission_ratio]' role='measure' type='quantitative' />
            <column caption='Facility Id' datatype='string' name='[facility_id]' role='dimension' type='nominal' />
            <column caption='Hospital Ownership' datatype='string' name='[hospital_ownership]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0948661308080131]' derivation='None' name='[none:Calculation_0948661308080131:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0948661310402565]' derivation='None' name='[none:Calculation_0948661310402565:nk]' pivot='key' type='nominal' />
            <column-instance column='[condition_name]' derivation='None' name='[none:condition_name:nk]' pivot='key' type='nominal' />
            <column caption='Number Of Discharges' datatype='integer' name='[number_of_discharges]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0948661160878080]' derivation='User' name='[usr:Calculation_0948661160878080:qk]' pivot='key' type='quantitative' />

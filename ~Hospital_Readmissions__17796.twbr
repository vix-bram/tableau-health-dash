            <column aggregation='Avg' caption='Much worse (&gt;1.10)' datatype='integer' default-format='*0.0%;0.0%' name='[Calculation_0948661251657729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([excess_readmission_ratio]) THEN IIF([excess_readmission_ratio] &gt; 1.1, 1, 0) END' />
            </column>
            <column aggregation='Avg' caption=' Much better (&lt;0.90)' datatype='integer' default-format='*0.0%;0.0%' name='[Calculation_0948661252018178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([excess_readmission_ratio]) THEN IIF([excess_readmission_ratio] &lt; 0.9, -1, 0) END' />
            </column>
            <column-instance column='[Calculation_0948661251657729]' derivation='Avg' name='[avg:Calculation_0948661251657729:qk]' pivot='key' type='quantitative' />

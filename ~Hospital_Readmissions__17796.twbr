      <aliases enabled='yes' />
      <column caption='Hospitals with ratio' datatype='integer' name='[Calculation_0948661160878080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([excess_readmission_ratio]) THEN [facility_id] END)' />
      </column>
      <column aggregation='Avg' caption='Much worse (&gt;1.10)' datatype='integer' default-format='*0.0%;0.0%' name='[Calculation_0948661251657729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([excess_readmission_ratio]) THEN IIF([excess_readmission_ratio] &gt; 1.1, 1, 0) END' />
      </column>
      <column aggregation='Avg' caption=' Much better (&lt;0.90)' datatype='integer' default-format='*0.0%;0.0%' name='[Calculation_0948661252018178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([excess_readmission_ratio]) THEN IIF([excess_readmission_ratio] &lt; 0.9, -1, 0) END' />
      </column>
      <column caption='Ownership group' datatype='string' name='[Calculation_0948661308080131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [hospital_ownership]&#13;&#10;WHEN &quot;Government - Federal&quot; THEN &quot;Other (Federal, Tribal)&quot;&#13;&#10;WHEN &quot;Tribal&quot; THEN &quot;Other (Federal, Tribal)&quot;&#13;&#10;ELSE [hospital_ownership]&#13;&#10;END' />
      </column>
      <column caption='Meets minimum discharges' datatype='boolean' name='[Calculation_0948661310402565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 0948661309857796] = 0 OR [number_of_discharges] &gt;= [Parameters].[Parameter 0948661309857796]' />
      </column>
      <column caption='Hospital' datatype='string' name='[Calculation_1728765049499648]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[facility_name] + &quot; (&quot; + [city_town] + &quot;, &quot; + [state] + &quot;)&quot;' />
      </column>
      <column caption='Readmissions vs Expected' datatype='real' default-format='*+0.0%;-0.0%;0.0%' name='[Calculation_1728765049622529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([excess_readmission_ratio]) - 1' />
      </column>
      <column caption='State vs Expected' datatype='real' default-format='*+0.0%;-0.0%;0.0%' name='[Calculation_1728765050327042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [state], [condition_name]: AVG([excess_readmission_ratio])}) - 1' />
      </column>
      <column caption='Worse than Expected' datatype='boolean' name='[Calculation_1728765050564611]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1728765049622529] &gt; 0' />
      </column>
      <column caption='Condition Label' datatype='string' name='[Calculation_1728765113356292]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[condition_name] + IF ISNULL([excess_readmission_ratio]) THEN &quot; – &quot; + [footnote_text] ELSE &quot;&quot; END' />
      </column>
      <column caption='hospital_condition.csv' datatype='table' name='[__tableau_internal_object_id__].[hospital_condition.csv_517B2553BCDF4D42980E9109C1C9828F]' role='measure' type='quantitative' />
      <column caption='Above 1' datatype='integer' default-format='p0.0%' name='[above_1]' role='measure' type='quantitative' />
      <column caption='City Town' datatype='string' name='[city_town]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Condition Code' datatype='string' name='[condition_code]' role='dimension' type='nominal' />
      <column caption='Condition Name' datatype='string' name='[condition_name]' role='dimension' type='nominal' />
